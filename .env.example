# Salin file ini menjadi .env lalu isi nilainya.

# true = pakai data contoh (tanpa memanggil AI, gratis). false = panggil AI sungguhan.
USE_MOCK_AI=true
MAX_TOKENS=16000
# Effort Claude: low | medium | high (kosong = bawaan model). Lebih rendah = lebih cepat selesai.
AI_EFFORT=low
# Percobaan ulang otomatis bila koneksi ke AI putus di tengah jalan
AI_NET_RETRIES=2

# Claude (Anthropic)
API_BASE_URL=https://api.anthropic.com
API_KEY=
API_MODEL=claude-opus-5

# Database (default XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=planku
DB_USER=root
DB_PASS=

# Batas panggilan AI per IP per jam
RATE_LIMIT_PER_HOUR=30

# Batas panggilan AI untuk dokumen (langkah 5) per project
DOC_MAX_CALLS_PER_PROJECT=36

# Bikin Task: jumlah fitur maksimal per panggilan AI, dan jeda minimum (detik) antar panggilan
TASK_FEATURES_PER_CALL=4
AI_MIN_INTERVAL_SECONDS=2

# Workspace Agent (chat): kuota per IP per jam terpisah dari kuota dokumen, dan batas panjang jawaban
AGENT_RATE_LIMIT_PER_HOUR=40
AGENT_MAX_TOKENS=2000
